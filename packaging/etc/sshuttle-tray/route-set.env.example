# /etc/sshuttle-tray/route-set.env — the Route Set the Tunnel pushes.
# Owned by the apply unit (the Tool's settings dialog installs it with one
# password prompt); hand edits are equally valid — the last writer wins and
# changes take effect on the next Tunnel start. A missing file means 0/0
# (the full tunnel).

# Space-separated IPv4 CIDRs; 0/0 routes everything. Bare IPs mean /32.
SSHUTTLE_SUBNETS=192.0.2.0/24 198.51.100.0/24

# Optional: a host inside the Route Set that must answer pings while the
# Tunnel is active. Three consecutive failures raise the Alert; any success
# clears it. Leave unset (or empty) when echo endpoints already see the tunnel.
#SSHUTTLE_PING_TARGET=192.0.2.55
