# /etc/sshuttle-tray/tunnel.env — static install-time Tunnel settings.
# Required: the Tunnel unit fails fast when this file is missing.
# Edit once at install; the Tool never writes here.

# SSHUTTLE_REMOTE — the sshuttle relay (-r): your configured SSH alias,
# or user@host[:port]. Displayed by the Tool as the Remote Gateway, never probed.
SSHUTTLE_REMOTE=relay.example

# SSHUTTLE_REMOTE_SHELL — one word: the ssh BINARY on THIS machine that
# sshuttle runs (--ssh-cmd). Not the relay's shell. Almost always "ssh".
# Key auth is required (root, non-interactive): see docs/key-auth.md.
SSHUTTLE_REMOTE_SHELL=ssh
